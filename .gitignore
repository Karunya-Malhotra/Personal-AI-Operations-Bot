# Python bytecode
__pycache__/
*.py[cod]

# Virtualenvs. `make install` creates .venv from uv.lock, so it is reproducible
# rather than precious -- committing it would defeat the point of the lockfile.
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/

# Local configuration. `.env` holds the real DATABASE_URL and, from M1B, real
# API keys; `.env.example` is the tracked template.
.env

# Build artefacts
build/
dist/
*.egg-info/
