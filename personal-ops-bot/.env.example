# Copy to .env and edit. .env is gitignored; this template is not.
#
# Every value here has a working default in app/config/settings.py, so an empty
# .env runs against the local dev database with a scripted model. Nothing in
# this file is required to start.

# --- deployment identity -----------------------------------------------------
# Checked against the stamp the database carries (app/db/guard.py). A mismatch
# refuses to start, in both directions.
APP_ENV=dev

# --- database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aiops:aiops@localhost:5432/aiops_dev

# --- language model ----------------------------------------------------------
# anthropic | gemini | fake
#
# `fake` runs the whole application against a scripted model: no key, no
# network, no cost. It is the default worth starting with.
LLM_PROVIDER=fake

# Passed straight through to the provider. The default suits Anthropic; Gemini
# uses an unrelated id vocabulary, so set this explicitly when switching.
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=30

# Only the key for the selected provider is read. Startup fails with a clear
# message if the selected provider has none.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
#
# NOTE on Gemini: Google's *unpaid* tier trains on submitted content, permits
# human review of inputs and outputs, and its terms say not to submit personal
# information. This application's payload is personal notes, expenses and
# attendance. Use a billing-enabled key, or accept that tradeoff knowingly.

# --- observability -----------------------------------------------------------
LOG_LEVEL=INFO
# Defaults to true in prod, false in dev.
# LOG_JSON=false
